# Compose
COMPOSE_PROJECT_NAME=urban-insight
GATEWAY_HTTP_PORT=80
POSTGRES_PORT=5432
MAIL_ADMIN_HTTP_PORT=8082
MAIL_SMTP_PORT=25
MAIL_SMTPS_PORT=465
MAIL_SUBMISSION_PORT=587
MAIL_IMAP_PORT=143
MAIL_IMAPS_PORT=993
LETSENCRYPT_DIR=/etc/letsencrypt
PRIMARY_DOMAIN=urbaninsights.site
MAIL_DOMAIN=urbaninsights.site
MAIL_HOSTNAME=mail.urbaninsights.site

# PostgreSQL
POSTGRES_DB=urban_insight
POSTGRES_USER=urban_insight
POSTGRES_PASSWORD=urban_insight
DATABASE_URL=postgresql+psycopg://urban_insight:urban_insight@postgres:5432/urban_insight

# Shared runtime
UPLOAD_DIR=/data/uploads
THUMBNAIL_DIR=/data/thumbnails
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://urbaninsights.site,https://urbaninsights.site,http://www.urbaninsights.site,https://www.urbaninsights.site

# LLM
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.longcat.chat/openai
LLM_MODEL=LongCat-Flash-Lite
LLM_CACHE_TTL_SECONDS=3600

# Recognition models
ATTR_MODEL_PATH=model/models/mobilenet/best_model.pth
ATTR_MODEL_NAME=
ATTR_IMAGE_SIZE=224
SEARCH_ATTR_MODEL_PATH=model/models/convnextv2/convxnextv2.pt
SEARCH_ATTR_MODEL_NAME=
SEARCH_ATTR_IMAGE_SIZE=224
ANALYSIS_ATTR_MODEL_PATH=model/models/mobilenet/best_model.pth
ANALYSIS_ATTR_MODEL_NAME=
ANALYSIS_ATTR_IMAGE_SIZE=224
REID_BACKEND=
REID_MODEL_PATH=
REID_MODEL_NAME=
REID_INPUT_SIZE=
SEARCH_REID_BACKEND=torchreid
SEARCH_REID_MODEL_NAME=osnet_x1_0
SEARCH_REID_MODEL_PATH=model/models/reid/osnet_x1_0_imagenet.pth
SEARCH_REID_INPUT_SIZE=256x128
ANALYSIS_REID_BACKEND=
ANALYSIS_REID_MODEL_NAME=
ANALYSIS_REID_MODEL_PATH=
ANALYSIS_REID_INPUT_SIZE=

# Agent runtime
AGENT_SERVICE_BASE_URL=http://127.0.0.1:8000
AGENT_CONTROL_PLANE_URL=http://127.0.0.1:8000
AGENT_EXECUTOR_URL=http://127.0.0.1:8000
AGENT_SERVICE_ENABLE_RUNTIME=1
AGENT_SERVICE_ENABLE_SCHEDULER=1
AGENT_SERVICE_ENABLE_EMAIL_POLLER=1
AGENT_SERVICE_ENABLE_SUPERVISOR=1
AGENT_SERVICE_STARTUP_DELAY_SECONDS=2
AGENT_SERVICE_SUPERVISOR_POLL_SECONDS=5
AGENT_SERVICE_LOOP_STALE_SECONDS=45

# Agent tools and scheduling
AUTH_SERVICE_URL=http://auth-service:8000
MEDIA_SERVICE_URL=http://media-service:8000
ANALYSIS_SERVICE_URL=http://analysis-service:8000
SEARCH_SERVICE_URL=http://search-service:8000
INSIGHT_SERVICE_URL=http://insight-service:8000
AGENT_EXECUTOR_TIMEOUT_SECONDS=30
AGENT_RUNTIME_POLL_SECONDS=3
AGENT_RUNTIME_HEARTBEAT_SECONDS=10
AGENT_RUNTIME_LEASE_SECONDS=30
AGENT_SCHEDULER_POLL_SECONDS=10
AGENT_SCHEDULER_DISPATCH_LIMIT=20

# Agent mail connector
AGENT_EMAIL_DELIVERY_MODE=log
AGENT_EMAIL_FROM_ADDRESS=agent@urbaninsights.site
AGENT_EMAIL_POLL_SECONDS=10
AGENT_EMAIL_OUTBOX_DIR=/data/agent-email-outbox
AGENT_WORKSPACE_DIR=/data/agent-workspace
AGENT_EMAIL_SMTP_HOST=
AGENT_EMAIL_SMTP_PORT=587
AGENT_EMAIL_SMTP_USERNAME=
AGENT_EMAIL_SMTP_PASSWORD=
AGENT_EMAIL_SMTP_USE_TLS=1
AGENT_EMAIL_IMAP_ENABLE=0
AGENT_EMAIL_IMAP_HOST=
AGENT_EMAIL_IMAP_PORT=993
AGENT_EMAIL_IMAP_USERNAME=
AGENT_EMAIL_IMAP_PASSWORD=
AGENT_EMAIL_IMAP_USE_SSL=1
AGENT_EMAIL_IMAP_MAILBOX=INBOX
AGENT_EMAIL_STATE_PATH=/data/agent-email-state/imap-state.json
