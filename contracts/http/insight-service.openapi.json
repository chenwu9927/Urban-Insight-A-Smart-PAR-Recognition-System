  "paths": {
    "/stats": {
      "get": {
        "summary": "Get Stats",
        "description": "获取客流统计数据。\n- file_id: 可选，指定文件ID过滤\n- interval: 时间间隔（分钟），支持 1, 5, 30, 60\n- date: 可选，指定日期过滤（格式 YYYY-MM-DD）",
        "operationId": "get_stats_stats_get",
        "parameters": [
          {
            "name": "file_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "可选：指定文件ID进行过滤",
              "title": "File Id"
            },
            "description": "可选：指定文件ID进行过滤"
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "时间间隔（分钟），可选 1, 5, 30, 60",
              "default": 60,
              "title": "Interval"
            },
            "description": "时间间隔（分钟），可选 1, 5, 30, 60"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "可选：指定日期过滤，格式YYYY-MM-DD",
              "title": "Date"
            },
            "description": "可选：指定日期过滤，格式YYYY-MM-DD"
          },
          {
            "name": "dedup",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "是否按 person_id 去重(1/0)",
              "default": 1,
              "title": "Dedup"
            },
            "description": "是否按 person_id 去重(1/0)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
