  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "file_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Id"
          },
          "interval": {
            "type": "integer",
            "title": "Interval",
            "default": 60
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "use_llm": {
            "type": "integer",
            "title": "Use Llm",
            "default": 1
          },
          "dedup": {
            "type": "integer",
            "title": "Dedup",
            "default": 1
          },
          "cache": {
            "type": "integer",
            "title": "Cache",
            "default": 1
          },
          "refresh": {
            "type": "integer",
            "title": "Refresh",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "HTTPValidationError": {
        "properties": {
